# The Pactora API. Public — it is compiled into the client bundle, so it must
# never hold anything secret.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# Who runs the service and how to reach them. Public, like every NEXT_PUBLIC_
# value. Unset, the site says so plainly: "Email address coming soon — use
# GitHub meanwhile", no X link at all, and "the Pactora operator ([name to be
# confirmed])".
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_X_HANDLE=
NEXT_PUBLIC_OPERATOR_NAME=
