# Every value here is compiled into the client bundle (NEXT_PUBLIC_), so none
# may hold a secret. Copy to .env.local and fill in what your deployment needs.

# The Pactora API. Required: a production build (`pnpm build`) fails without
# it rather than shipping a site that talks to localhost. `next dev` and the
# tests fall back to http://127.0.0.1:8080.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# This site's own public URL, for absolute Open Graph, canonical and sitemap
# links. Unset: http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://pactora.example

# Who runs the service and how to reach them. Unset, the site says so plainly:
# "Email address coming soon — use GitHub meanwhile", no X link at all, and
# "the Pactora operator ([name to be confirmed])".
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_X_HANDLE=
NEXT_PUBLIC_OPERATOR_NAME=

# Extra block-explorer hosts an API link may point at (comma separated).
# NearBlocks (testnet.nearblocks.io, nearblocks.io) is built in; any other
# host renders as plain text (lib/links.ts).
# NEXT_PUBLIC_EXPLORER_HOSTS=explorer.example

# NEAR RPC origins the Content-Security-Policy lets the browser reach (space or
# comma separated). Default: https://rpc.testnet.near.org (lib/csp.mjs).
# NEXT_PUBLIC_RPC_ORIGINS=https://rpc.testnet.near.org

# Origins NEAR Connect and its wallets may reach: the wallet manifest, each
# wallet's code and the hosts that code talks to. Replaces the default list in
# lib/csp.mjs when set.
# NEXT_PUBLIC_WALLET_ORIGINS=https://raw.githubusercontent.com https://cdn.jsdelivr.net

# /register amounts, in yoctoNEAR (lib/wallet.ts). Testnet defaults: the
# storage deposit for register_agent (0.1 NEAR), the new agent account's
# funding (0.5 NEAR) and the signer key's gas allowance (0.25 NEAR).
# NEXT_PUBLIC_REGISTER_STORAGE_DEPOSIT_YOCTO=100000000000000000000000
# NEXT_PUBLIC_REGISTER_AGENT_FUNDING_YOCTO=500000000000000000000000
# NEXT_PUBLIC_REGISTER_KEY_ALLOWANCE_YOCTO=250000000000000000000000

# `1` shows the narrated videos (components/TourVideo.tsx) on the home page
# and /demo. Set it only once public/video/ holds overview.* and demo.*
# (webm, mp4, poster png, vtt captions); unset, the pages link to /demo.
# NEXT_PUBLIC_TOUR_VIDEO=1

# Tests only. `1` makes the build honour the scripted wallet the Playwright
# suite installs (window.__pactoraTestWallet). Never set it for a deployment.
# NEXT_PUBLIC_E2E_WALLET=1
